# Copy to .env for local development; configure equivalent production secrets in Sites.
# Never commit actual secrets. Runtime service status reports configured keys only.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# BrandCurrent uses a separate schema when sharing a Supabase project with
# another app. Add the schema to Supabase's Data API exposed schemas first.
SUPABASE_DB_SCHEMA=brandcurrent
# 32 random bytes, base64-encoded. Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Optional rotating key ring, JSON object mapping key IDs to base64 32-byte keys.
# Keep the legacy key until all legacy ciphertext has been re-encrypted.
TOKEN_ACTIVE_KEY_ID=
TOKEN_ENCRYPTION_KEYS=
FIRECRAWL_API_KEY=
BROWSERLESS_API_KEY=
BROWSERLESS_URL=https://production-sfo.browserless.io
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-pro
GEMINI_REVIEW_MODEL=
PRICE_REVIEW_INPUT_PER_MILLION=
PRICE_REVIEW_OUTPUT_PER_MILLION=
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=0
PROCESSOR_URL=
PROCESSOR_SECRET=
# Processor also needs SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, GEMINI_API_KEY.
# Conservative maximum USD cost for a bounded operation; paid jobs refuse to run until configured.
COST_MAP=
COST_SCRAPE=
COST_BROWSER=
COST_SEARCH=
COST_TEXT=
COST_IMAGE=
COST_VIDEO=
COST_EMBEDDING=
COST_PROCESSOR=
COST_PUBLISH=
COST_X_PUBLISH=
COST_METRICS=
# Optional measured text-cost settlement, matching GEMINI_TEXT_MODEL's billing tier.
PRICE_TEXT_INPUT_PER_MILLION=
PRICE_TEXT_OUTPUT_PER_MILLION=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
META_API_VERSION=v23.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202604
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BrandCurrent/1.0 (contact: configure-your-support-address)

ATTRIBUTION_LOOKBACK_DAYS=30
# Optional additional approved OAuth scopes; defaults are in lib/server/social.ts.
LINKEDIN_SCOPES=openid profile w_member_social
