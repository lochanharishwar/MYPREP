# ==========================================
# InkWise Environment Configuration (Gemma 4)
# ==========================================

# Active Gemma 4 Backend: 'ollama' | 'google-gemma-api' | 'mock'
GEMMA_BACKEND=ollama

# Ollama Local Configuration (Default MVP)
GEMMA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Approved Gemma 4 Ollama tags: gemma4:e2b | gemma4:e4b | gemma4:12b | gemma4:26b | gemma4:31b
GEMMA_OLLAMA_MODEL=gemma4:e4b

# Google Gemini API Hosted Gemma 4 Configuration
# Approved Hosted Gemma 4 IDs: gemma-4-26b-a4b-it | gemma-4-31b-it
GEMMA_GOOGLE_MODEL=gemma-4-26b-a4b-it
GEMINI_API_KEY=

# Optional Hugging Face Transformers Worker (Advanced Audio/Vision)
GEMMA_TRANSFORMERS_MODEL=google/gemma-4-12B-it

# Inference Controls & Budgets
GEMMA_REQUEST_TIMEOUT_MS=120000
GEMMA_MAX_IMAGE_EDGE=1400
GEMMA_MAX_OUTPUT_TOKENS=1200
GEMMA_ENABLE_THINKING=auto
GEMMA_ENABLE_NATIVE_AUDIO=false

# SQLite Database (Zero Docker required on Windows localhost)
DATABASE_URL=file:./dev.db

# Mathematical Verification Service (FastAPI + SymPy)
MATH_SERVICE_URL=http://127.0.0.1:8001

# Public Branding & Settings
NEXT_PUBLIC_APP_NAME=InkWise
